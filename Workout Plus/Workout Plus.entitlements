<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<!-- Shared with the widget extension. The widget can't read the SwiftData
	     store, so the app publishes a small JSON snapshot into this container
	     instead — far cheaper than moving the whole database into a group
	     container and migrating it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(WORKOUT_APP_GROUP)</string>
	</array>
</dict>
</plist>
