{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workout Plus plan",
  "type": "object",
  "required": [
    "id",
    "name",
    "summary",
    "daysPerWeek",
    "rotation",
    "workouts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "maxLength": 8000
    },
    "daysPerWeek": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "rotation": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "workouts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "focus",
          "exercises"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "focus": {
            "type": "string",
            "maxLength": 2000
          },
          "exercises": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "type": "object",
              "required": [
                "name",
                "category",
                "sets",
                "repRangeLow",
                "repRangeHigh",
                "isTimed",
                "imageURLs",
                "feel",
                "steps",
                "tip"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "category": {
                  "type": "string",
                  "maxLength": 100,
                  "minLength": 1
                },
                "sets": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "repRangeLow": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600
                },
                "repRangeHigh": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600
                },
                "isTimed": {
                  "type": "boolean"
                },
                "imageURLs": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "string",
                    "maxLength": 2048,
                    "pattern": "^https://raw\\.githubusercontent\\.com/yuhonas/free-exercise-db/main/exercises/[^?#@]+\\.(jpg|jpeg|png|webp|heic)$"
                  }
                },
                "feel": {
                  "type": "string",
                  "maxLength": 2000
                },
                "steps": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "tip": {
                  "type": "string",
                  "maxLength": 4000
                },
                "supersetGroup": {
                  "type": "string",
                  "maxLength": 100
                },
                "isBodyweight": {
                  "type": "boolean"
                },
                "isAssisted": {
                  "type": "boolean"
                },
                "restSeconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1800
                },
                "weightIncrementKg": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 50
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "isTimed": {
                        "const": false
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "repRangeLow": {
                        "maximum": 1000
                      },
                      "repRangeHigh": {
                        "maximum": 1000
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$comment": "The app additionally checks low <= high, unique workout IDs, rotation references and strict image URL components."
}
